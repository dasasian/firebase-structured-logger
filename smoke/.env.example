# Copy to smoke/.env.local and fill in. Both files stay out of git.
#
# The Firebase project the smoke functions deploy to. Must be its own project —
# smoke runs write real log entries, and assertions filter on them, so a stray
# match against production logs would go green for the wrong reason.
FSL_SMOKE_PROJECT=your-smoke-project-id

# The project's default Storage bucket, without the gs:// prefix.
FSL_SMOKE_BUCKET=your-smoke-project.firebasestorage.app

# Label applied to every entry a run writes.
FSL_SMOKE_APP_ID=smoke-app
