# Dependencies
node_modules/

# Package manager lock files (exclude non-npm)
yarn.lock
pnpm-lock.yaml
# Note: package-lock.json is committed for reproducible builds

# Build output
dist/
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# Firebase credentials
*.json
!package.json
!package-lock.json
!tsconfig.json
!firebase.json

# Smoke test — real project ids and bucket names live in env files only
smoke/.env.local
smoke/functions/.env
smoke/functions/lib/
smoke/**/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
coverage/
.nyc_output/
# Throwaway log dirs the emulator-mode suites write to (removed on a clean run,
# left behind when a suite fails part-way)
test-*-output/
*.tgz
